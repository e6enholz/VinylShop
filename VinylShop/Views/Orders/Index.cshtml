@model IEnumerable<VinylShop.Models.Delivery>

@{
    ViewData["Title"] = "Управление заказами";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="text-uppercase fw-bold text-secondary">📦 Мониторинг заказов и доставки</h2>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white mb-0">
            <thead class="table-dark text-uppercase fs-7">
                <tr>
                    <th scope="col" class="ps-4">ID Заказа</th>
                    <th scope="col">Дата оформления</th>
                    <th scope="col">Покупатель</th>
                    <th scope="col">Статус клиента</th>
                    <th scope="col">Адрес доставки</th>
                    <th scope="col">Статус груза</th>
                    <th scope="col" class="text-end pe-4">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold ps-4">#@item.id_delivery</td>
                        <td class="text-muted">@item.orderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <strong class="text-dark">@item.User?.login</strong><br />
                            <small class="text-muted">@item.User?.email</small>
                        </td>
                        <td>
                                <span class="badge bg-secondary">@item.User?.Status?.name</span>
                        </td>
                        <td><span class="text-truncate d-inline-block" style="max-width: 200px;">@item.delivery_address</span></td>
                        <td>
                            <span class="badge bg-warning text-dark">🚚 @item.status_text</span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end align-items-center gap-2">
                                <a asp-action="Details" asp-route-id="@item.id_delivery" class="btn btn-sm btn-info text-white">Детали</a>

                                <form asp-action="ChangeStatus" asp-route-id="@item.id_delivery" method="post" class="d-flex gap-1">
                                    <select name="newStatus" class="form-select form-select-sm" style="width: 110px;">
                                        <option value="В обработке">В обработке</option>
                                        <option value="В пути">В пути</option>
                                        <option value="Доставлен">Доставлен</option>
                                        <option value="Отменён">Отменён</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-dark">ОК</button>
                                </form>

                                <form asp-action="DeleteOrder" asp-route-id="@item.id_delivery" method="post"
                                      onsubmit="return confirm('Удалить заказ №@item.id_delivery? Это действие необратимо.');">
                                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>